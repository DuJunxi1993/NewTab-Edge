{
  "manifest_version": 3,
  "name": "NewTab - Edge",
  "version": "1.0.0",
  "description": "A Windows 11 / Edge-styled new tab page with custom wallpaper, blur/brightness controls, and multi-engine search.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "NewTab"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}

